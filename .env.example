# Copy to .env and export manually, or set these in your shell; the backend reads process env only (no dotenv loader).
# Backend
# STORE_DIR / SAMPLES_DIR / DB_PATH default to paths under the repo root's data/
# directory (see backend/app/config.py's REPO_ROOT) when unset. The values below
# are written relative to the repo root -- if you export them, either run the
# backend from the repo root or use absolute paths, since a relative value here
# resolves against whatever directory the process was started from (e.g.
# backend/, which the dev/test scripts cd into), not against the repo root.
STORE_DIR=./data/store
SAMPLES_DIR=./data/samples
DB_PATH=./data/store/index.sqlite
MAX_UPLOAD_MB=500
CORS_ORIGINS=http://localhost:5173
# Frontend
# Backend listens on 8001 (8000 is commonly taken by Windows iphlpsvc)
VITE_API_URL=http://localhost:8001
